---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Download } from '@lucide/astro';
import { Image } from 'astro:assets';
import cursorLogo from '../assets/cursor-logo.svg';
import cursorVideo from '../assets/mp4/steps_download_cursor.mp4';
import VideoModal from './VideoModal.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-24 relative border-b border-white/5">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white mb-4">
        {t('install.title')}
      </h2>
      <p class="text-lg text-zinc-400 max-w-2xl mx-auto">
        {t('install.desc')}
      </p>
    </div>

    <div class="max-w-4xl mx-auto animate-fade-in-up" style="animation-delay: 0.2s; opacity: 0;">
      <div class="bg-gradient-to-b from-white/8 to-transparent p-[1px] rounded-3xl hover-lift">
        <div class="glass-panel rounded-3xl p-8 sm:p-12 flex flex-col md:flex-row gap-12 items-center">
          
          <div class="flex-1 space-y-6">
            <div class="flex items-center gap-4 mb-2">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-lg border border-white/10 text-[#26251e]">
                <Image src={cursorLogo} alt="Cursor Logo" class="w-7 h-7 object-contain" />
              </div>
              <div>
                <h3 class="text-2xl font-bold text-white">Cursor IDE</h3>
                <span class="text-zinc-500 text-sm">{t('install.cursor.desc')}</span>
              </div>
            </div>
            
            <p class="text-zinc-300 text-lg leading-relaxed">
              {t('install.cursor.text')}
            </p>
            
            <a 
              href="https://cursor.com/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white text-black font-semibold hover:bg-zinc-200 transition-colors shadow-xl shadow-white/10"
            >
              <Download class="w-5 h-5" />
              {t('install.btn')}
            </a>
          </div>

          <div class="w-full md:w-1/2 shrink-0">
            <VideoModal videoSrc={cursorVideo} idSuffix="install" />
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
