---
interface Props {
  videoSrc: string;
  idSuffix: string;
  class?: string;
}

const { videoSrc, idSuffix, class: className = '' } = Astro.props;
---

<video-modal data-modal-id={`modal-${idSuffix}`}>
  <button 
    class={`video-trigger bg-black/50 border border-white/10 w-full aspect-video rounded-xl flex items-center justify-center text-zinc-500 font-medium text-sm text-center shadow-2xl relative overflow-hidden group/image cursor-pointer hover:scale-[1.02] transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-supabase/50 ${className}`} 
    aria-label="Reproducir vídeo"
    aria-haspopup="dialog"
  >
    <video 
      src={videoSrc} 
      class="preview-video w-full h-full object-cover opacity-70 group-hover/image:opacity-100 transition-opacity duration-500"
      loop 
      muted 
      playsinline
      preload="none"
    ></video>
    <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/10 to-transparent opacity-0 group-hover/image:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/image:opacity-100 transition-opacity duration-500 z-20 pointer-events-none scale-90 group-hover/image:scale-100">
      <div class="bg-black/60 p-3 rounded-full backdrop-blur-md shadow-[0_0_20px_rgba(0,0,0,0.5)] border border-white/20 text-white">
        <svg class="w-6 h-6 ml-1" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </div>
    </div>
  </button>

  <dialog 
    id={`modal-${idSuffix}`} 
    class="backdrop:bg-black/90 bg-transparent p-0 max-w-5xl w-full rounded-2xl border border-white/10 shadow-2xl overflow-hidden shadow-black/50 m-auto focus:outline-none"
    aria-label="Previsualización de vídeo"
  >
    <div class="relative bg-zinc-950">
      <video 
        class="modal-video w-full aspect-video object-contain"
        src={videoSrc}
        controls
        loop
        playsinline
        preload="none"
      ></video>
      <button 
        class="close-modal absolute top-4 right-4 bg-black/50 hover:bg-black/80 text-white p-2.5 rounded-full transition-colors backdrop-blur-md z-50 border border-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/20 cursor-pointer"
        aria-label="Cerrar modal"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </dialog>
</video-modal>

<script>
  class VideoModal extends HTMLElement {
    observer: IntersectionObserver | null = null;
    
    connectedCallback() {
      const trigger = this.querySelector('.video-trigger') as HTMLButtonElement;
      const modal = this.querySelector('dialog') as HTMLDialogElement;
      const closeModalBtn = this.querySelector('.close-modal') as HTMLButtonElement;
      const modalVideo = this.querySelector('.modal-video') as HTMLVideoElement;
      const previewVideo = this.querySelector('.preview-video') as HTMLVideoElement;

      // Handle intersection observer for preview video
      if ('IntersectionObserver' in window && previewVideo) {
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        }, { rootMargin: '50px' });
        this.observer.observe(previewVideo);
      } else if (previewVideo) {
        previewVideo.play().catch(() => {});
      }

      // Handle modal open
      if (trigger && modal && modalVideo) {
        trigger.addEventListener('click', () => {
          modal.showModal();
          modalVideo.play().catch(() => {});
        });
      }

      // Handle modal close
      const closeModal = () => {
        modal.close();
        modalVideo.pause();
      };

      if (closeModalBtn) {
        closeModalBtn.addEventListener('click', closeModal);
      }

      // Close on backdrop click
      if (modal) {
        modal.addEventListener('click', (e) => {
          const dialogDimensions = modal.getBoundingClientRect();
          if (
            e.clientX < dialogDimensions.left ||
            e.clientX > dialogDimensions.right ||
            e.clientY < dialogDimensions.top ||
            e.clientY > dialogDimensions.bottom
          ) {
            closeModal();
          }
        });
        
        // Ensure pause on ESC key
        modal.addEventListener('close', () => {
            modalVideo.pause();
        });
      }
    }
    
    disconnectedCallback() {
      if (this.observer) {
        this.observer.disconnect();
      }
    }
  }

  // Ensure it only defines the custom element once
  if (!customElements.get('video-modal')) {
    customElements.define('video-modal', VideoModal);
  }
</script>
